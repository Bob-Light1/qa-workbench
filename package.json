{
  "name": "qa-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:integration": "node --env-file-if-exists=.env.local scripts/integration.mjs",
    "qa": "node --env-file-if-exists=.env.local scripts/qa.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "predeploy": "node --env-file-if-exists=.env.production.local scripts/deploy-check.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name qa-workbench"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "supabase": "^2.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
